# Interface de rede. 0.0.0.0 expõe na rede local (LAN); 127.0.0.1 restringe a este PC.
HOST=0.0.0.0
# Porta HTTP/WebSocket do servidor.
PORT=5810
# Diretório onde o banco SQLite é persistido.
DATA_DIR=./data
# Quantidade de threads dedicadas à IA (0 = automático: núcleos - 1, máx. 8).
AI_WORKERS=0
# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Origens extras permitidas para WebSocket/API, separadas por vírgula (ex.: http://localhost:5173 em dev).
# A própria origem do servidor é sempre aceita.
EXTRA_ORIGINS=
