# Copie para apps/web/.env.app.local (fora do git) e preencha com os valores de produção.
# Nenhum destes valores é secreto: todos vão dentro do app. Segredos (chave secreta da RevenueCat,
# senha da keystore) nunca entram em arquivo versionado.

# AdMob → Apps → seu app → Blocos de anúncios.
VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# 1 = anúncios de teste mesmo no build de produção (aparelhos de QA). Nunca 1 na loja.
VITE_ADS_TESTING=0

# RevenueCat → Project → API keys → chave pública do app Google Play (começa com goog_).
VITE_REVENUECAT_ANDROID_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL pública da política de privacidade (obrigatória na Play para apps com anúncios).
VITE_PRIVACY_URL=https://exemplo.com/privacidade
VITE_APP_VERSION=1.0.0
