{
  "name": "@dama/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor HTTP/WebSocket: partidas em rede local, IA em threads, persistência SQLite.",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --env-file=dev.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dama/engine": "1.0.0",
    "@dama/protocol": "1.0.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.3.1",
    "fastify": "5.12.5",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "pino-pretty": "13.1.3",
    "ws": "8.22.0"
  }
}
